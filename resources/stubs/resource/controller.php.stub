<?php

namespace App\Http\Controllers;

use App\Actions\{{plural}}\Create{{model}};
use App\Actions\{{plural}}\Update{{model}};
use App\Actions\{{plural}}\Delete{{model}};
use App\Actions\{{plural}}\List{{plural}};
use App\Http\Requests\Index{{model}}Request;
use App\Http\Requests\Store{{model}}Request;
use App\Http\Requests\Update{{model}}Request;
use App\Models\{{model}};
use Illuminate\Http\RedirectResponse;
use Illuminate\Support\Facades\Gate;
use Inertia\Inertia;
use Inertia\Response;
use Laravel\Head\Facades\Head;

class {{model}}Controller extends Controller
{
    public function index(Index{{model}}Request $request, List{{plural}} $list): Response
    {
        Head::title('{{label}}');
        $search = $request->string('search')->trim()->toString();

        return Inertia::render('{{route}}/Index', [
            'records' => $list->handle($search)->through(fn ({{model}} $record): array => $this->record($record)),
            'search' => $search,
            'canCreate' => $request->user()?->can('create', {{model}}::class) ?? false,
        ]);
    }

    public function create(): Response
    {
        Gate::authorize('create', {{model}}::class);
        Head::title('Créer — {{label}}');

        return Inertia::render('{{route}}/Create');
    }

    public function store(Store{{model}}Request $request, Create{{model}} $create): RedirectResponse
    {
        $record = $create->handle($request->attributesForResource());
        Inertia::flash('toast', ['type' => 'success', 'message' => 'Élément créé.']);

        return to_route('{{route}}.show', $record);
    }

    public function show({{model}} ${{variable}}): Response
    {
        Gate::authorize('view', ${{variable}});
        Head::title(${{variable}}->title);

        return Inertia::render('{{route}}/Show', ['record' => $this->record(${{variable}})]);
    }

    public function edit({{model}} ${{variable}}): Response
    {
        Gate::authorize('update', ${{variable}});
        Head::title('Modifier — '.${{variable}}->title);

        return Inertia::render('{{route}}/Edit', ['record' => $this->record(${{variable}})]);
    }

    public function update(Update{{model}}Request $request, {{model}} ${{variable}}, Update{{model}} $update): RedirectResponse
    {
        $update->handle(${{variable}}, $request->attributesForResource());
        Inertia::flash('toast', ['type' => 'success', 'message' => 'Élément modifié.']);

        return to_route('{{route}}.show', ${{variable}});
    }

    public function destroy({{model}} ${{variable}}, Delete{{model}} $delete): RedirectResponse
    {
        Gate::authorize('delete', ${{variable}});
        $delete->handle(${{variable}});
        Inertia::flash('toast', ['type' => 'success', 'message' => 'Élément supprimé.']);

        return to_route('{{route}}.index');
    }

    /** @return array{id: int, title: string, description: string|null, can: array{update: bool, delete: bool}} */
    private function record({{model}} $record): array
    {
        return ['id' => $record->id, 'title' => $record->title, 'description' => $record->description,
            'can' => ['update' => Gate::allows('update', $record), 'delete' => Gate::allows('delete', $record)]];
    }
}
