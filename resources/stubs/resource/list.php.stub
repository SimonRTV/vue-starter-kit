<?php

namespace App\Actions\{{plural}};

use App\Models\{{model}};

class List{{plural}}
{
    /** @return \Illuminate\Pagination\LengthAwarePaginator<int, {{model}}> */
    public function handle(string $search): \Illuminate\Pagination\LengthAwarePaginator
    {
        return {{model}}::query()
            ->when($search !== '', fn ($query) => $query->whereLike('title', '%'.$search.'%'))
            ->latest('id')->paginate(15)->withQueryString();
    }
}
